{
  "name": "auto-test-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "turbo test",
    "agent": "pnpm --filter @atp/agent demo",
    "e2e": "node scripts/e2e-agent.mjs",
    "e2e:update": "node scripts/e2e-update.mjs",
    "release": "node scripts/build-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "playwright"
    ]
  }
}
