{
  "case": {
    "id": "c-example-001",
    "name": "登录成功",
    "projectId": "p-example",
    "startUrl": "fixtures/login-form/index.html",
    "steps": [
      {
        "id": "s-001",
        "action": "fill",
        "elementId": "el-username",
        "params": { "value": "admin" }
      },
      {
        "id": "s-002",
        "action": "fill",
        "elementId": "el-password",
        "params": { "value": "admin123" }
      },
      { "id": "s-003", "action": "click", "elementId": "el-submit" },
      {
        "id": "s-004",
        "action": "assert",
        "elementId": "el-message",
        "assertion": { "type": "text", "expected": "登录成功" }
      }
    ]
  },
  "elements": {
    "el-username": {
      "id": "el-username",
      "name": "用户名输入框",
