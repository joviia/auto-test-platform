        { "type": "testId", "value": "username-input" },
        { "type": "role", "value": "textbox", "name": "用户名" },
        { "type": "css", "value": "#username" }
      ]
    },
    "el-password": {
      "id": "el-password",
      "name": "密码输入框",
      "locators": [
        { "type": "testId", "value": "password-input" },
        { "type": "role", "value": "textbox", "name": "密码" },
        { "type": "css", "value": "#password" }
      ]
    },
    "el-submit": {
      "id": "el-submit",
      "name": "登录按钮",
      "locators": [
        { "type": "testId", "value": "login-submit" },
        { "type": "role", "value": "button", "name": "登录" },
        { "type": "text", "value": "登录" },
        { "type": "css", "value": "#login-form > button[type=submit]" }
      ]
    },
    "el-message": {
      "id": "el-message",
      "name": "状态消息",
      "locators": [
        { "type": "testId", "value": "login-message" },
