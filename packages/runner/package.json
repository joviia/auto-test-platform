    "test": "vitest run"
  },
  "dependencies": {
    "@atp/model": "workspace:*",
    "@atp/recorder": "workspace:*",
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
